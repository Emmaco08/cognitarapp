{
  "name": "@cognitara/brevo-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for Brevo transactional emails, OTP verification, senders, templates, and contacts.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cognitara-brevo-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.2"
  }
}
