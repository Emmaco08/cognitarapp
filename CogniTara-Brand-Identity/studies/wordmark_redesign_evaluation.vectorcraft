                        1.0,
                        120.0,
                        272.0
                      ],
                      "runs": [
                        {
                          "text": "A bespoke enterprise wordmark engineered in direct dialogue with the Luminary C. Features 45° beveled terminal cuts mirroring the C symbol, an architectural capital T with chamfered undercuts, and an exquisitely proportioned micro-spark beacon tittle on 'i'. Both \"Cogni\" and \"Tara\" share exact cap-height, x-height, baseline, and stroke thickness, restoring visual equilibrium.",
                          "style": {
                            "font_family": "Plus Jakarta Sans",
                            "font_style": "Regular",
                            "size": 14.0,
                            "tracking": 0.0,
                            "baseline_shift": 0.0,
                            "h_scale": 100.0,
