{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CogniTara Studio Setup",
  "version": "../../package.json",
  "identifier": "net.cognitara.studio.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CogniTara Studio Setup",
        "width": 460,
        "height": 620,
        "minWidth": 460,
        "minHeight": 620,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "focus": true,
        "visible": false,
        "backgroundColor": "#070A12",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "CogniTara Education Technologies",
    "copyright": "Copyright © 2026 CogniTara",
    "shortDescription": "CogniTara Studio Setup",
    "windows": {
      "webviewInstallMode": { "type": "skip" }
    }
  }
}
